{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ndc-desk",
  "version": "0.1.0",
  "identifier": "dev.ndcdesk.terminal",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ndc-desk",
        "width": 1000,
        "height": 660,
        "minWidth": 680,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
